{
    "name": "hover-effects",
    "label": "BFB Hover Effects",
    "pack": "pro",
    "feature": true,
    "on": "every element, Bricks' own included",
    "docs": "https://builtforbricks.com/bfb-elements/docs/hover-effects/",
    "controlGroups": {
        "bfbeHover": {
            "title": "Hover effect",
            "tab": "style"
        }
    },
    "controls": {
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow"
            },
            "inline": true,
            "placeholder": "None"
        },
        "bfbeHoverOn": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverFrom": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Comes from",
            "type": "select",
            "options": {
                "up": "Above",
                "left": "The left",
                "right": "The right"
            },
            "inline": true,
            "placeholder": "Below",
            "required": [
                "bfbeHoverEffect",
                "=",
                "slide"
            ]
        },
        "bfbeHoverStrength": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Strength",
            "type": "number",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "inline": true,
            "placeholder": "1",
            "breakpoints": true,
            "css": [
                {
                    "property": "--bfbe-hv-k",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverSpeed": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Speed",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "300",
            "description": "Milliseconds.",
            "css": [
                {
                    "property": "--bfbe-hv-t",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverDelay": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Delay",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "0",
            "description": "Milliseconds, so parts arrive in sequence.",
            "css": [
                {
                    "property": "--bfbe-hv-d",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "bfbeHoverEffect",
                    "!=",
                    ""
                ],
                [
                    "bfbeHoverEffect",
                    "!=",
                    [
                        "tilt",
                        "follow"
                    ]
                ]
            ]
        },
        "bfbeHoverColor": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Colour",
            "type": "color",
            "inline": true,
            "css": [
                {
                    "property": "--bfbe-hv-c",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "=",
                [
                    "shine",
                    "border"
                ]
            ]
        },
        "bfbeHoverOff": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Off below",
            "type": "select",
            "options": {
                "480": "480 px",
                "640": "640 px",
                "768": "768 px",
                "992": "992 px"
            },
            "inline": true,
            "placeholder": "Never",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverScope": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Children respond to hover",
            "type": "checkbox",
            "description": "Parts inside set to A hovered parent move."
        }
    }
}
