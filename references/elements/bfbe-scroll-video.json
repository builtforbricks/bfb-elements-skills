    "controls": {
        "infoAttributes": {
            "tab": "style",
            "group": "_attributes",
            "content": "<a href=\"https://academy.bricksbuilder.io/article/custom-attributes\" target=\"_blank\" rel=\"noopener\">Custom attributes</a> will be added to the most relevant HTML node.",
            "type": "info"
        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/scroll-video/\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "file": {
            "tab": "content",
            "group": "bfbeVideo",
            "label": "Video file",
            "type": "file",
            "description": "Encode it with a keyframe every five frames."
        },
        "url": {
            "tab": "content",
            "group": "bfbeVideo",
            "label": "Or a video URL",
            "type": "text",
            "hasDynamicData": "text",
            "inline": true,
            "placeholder": "https://example.com/sequence.mp4"
        },
        "poster": {
            "tab": "content",
            "group": "bfbeVideo",
            "label": "Poster",
            "type": "image"
        },
        "mode": {
            "tab": "content",
            "group": "bfbeScroll",
            "label": "Behaviour",
            "type": "select",
            "options": {
                "pinned": "Pinned while scrolling",
                "inview": "Scrubs as it passes"
            },
            "inline": true,
            "placeholder": "Pinned while scrolling"
        },
        "distance": {
            "tab": "content",
            "group": "bfbeScroll",
            "label": "Scroll length",
            "description": "In screen heights; the content can make it longer.",
            "type": "number",
            "min": 1,
            "step": 0.5,
            "inline": true,
            "placeholder": 3,
            "required": [
                "mode",
                "!=",
                "inview"
            ],
            "breakpoints": true,
            "css": [
                {
                    "property": "--bfbe-sv-distance",
                    "selector": ""
                }
            ]
        },
        "smoothing": {
            "tab": "content",
            "group": "bfbeScroll",
            "label": "Smooth the scrub",
            "type": "checkbox"
        },
        "smoothStrength": {
            "tab": "content",
            "group": "bfbeScroll",
            "label": "Smoothing strength",
            "type": "select",
            "options": {
                "light": "Light",
                "medium": "Medium",
                "heavy": "Heavy"
            },
            "inline": true,
            "placeholder": "Medium",
            "required": [
                "smoothing",
                "!=",
                ""
            ]
        },
        "offBelow": {
            "tab": "content",
            "group": "bfbeScroll",
            "label": "Plain video below",
            "type": "select",
            "options": {
                "never": "Never",
                "480": "480px",
                "640": "640px",
                "768": "768px",
                "992": "992px"
            },
            "inline": true,
            "placeholder": "768px"
        },
        "videoHeight": {
            "tab": "content",
            "group": "bfbeLook",
            "label": "Video height",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "Auto",
            "description": "Unset: the screen, or the video&#039;s own shape.",
            "css": [
                {
                    "property": "--bfbe-sv-h",
                    "selector": ""
                },
                {
                    "property": "--bfbe-sv-ratio",
                    "selector": "",
                    "value": "auto"
                }
            ]
        },
        "videoAt": {
            "tab": "content",
            "group": "bfbeLook",
            "label": "Video sits",
            "type": "select",
            "options": {
                "top": "Top",
                "center": "Centre",
                "bottom": "Bottom"
            },
            "inline": true,
            "placeholder": "Centre",
            "description": "On the screen, when shorter than it.",
            "required": [
                "mode",
                "!=",
                "inview"
            ],
            "css": [
                {
                    "property": "--bfbe-sv-at",
                    "selector": "",
                    "value": "0",
                    "required": "top"
                },
                {
                    "property": "--bfbe-sv-at",
                    "selector": "",
                    "value": "0.5",
                    "required": "center"
                },
                {
                    "property": "--bfbe-sv-at",
                    "selector": "",
                    "value": "1",
                    "required": "bottom"
                }
            ]
        },
        "fit": {
            "tab": "content",
            "group": "bfbeLook",
