            "popup": true,
            "inline": true,
            "required": [
                "hasLoop",
                "!=",
                ""
            ]
        },
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow"
            },
            "inline": true,
            "placeholder": "None"
        },
        "bfbeHoverOn": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverFrom": {
            "tab": "style",
            "group": "bfbeHover",
