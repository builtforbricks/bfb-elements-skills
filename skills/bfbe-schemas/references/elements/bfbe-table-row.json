            "label": "Header row",
            "type": "checkbox"
        },
        "rowBackground": {
            "tab": "content",
            "group": "bfbeRow",
            "label": "Background",
            "type": "background",
            "css": [
                {
                    "property": "background",
                    "selector": ".bfbe-table__cell"
                }
            ]
        },
        "rowTypography": {
            "tab": "content",
            "group": "bfbeRow",
            "label": "Typography",
