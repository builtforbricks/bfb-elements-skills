            "type": "select",
            "options": {
                "up": "Above",
                "left": "The left",
                "right": "The right"
            },
            "inline": true,
            "placeholder": "Below",
            "required": [
                "bfbeHoverEffect",
                "=",
                "slide"
            ]
        },
