{
    "name": "bfbe-bundle-builder",
    "label": "BFB Bundle Builder",
    "pack": "pro",
    "skill": "bfbe-bundle-builder",
    "docs": "https://builtforbricks.com/bfb-elements/docs/bundle-builder/",
    "nestable": true,
    "children": [
        "bfbe-bundle-title",
        "bfbe-bundle-progress",
        "bfbe-bundle-products"
    ],
    "childrenDefault": [
        {
            "name": "bfbe-bundle-title",
            "label": "Title"
        },
        {
            "name": "bfbe-bundle-progress",
            "label": "Progress"
        },
        {
            "name": "bfbe-bundle-products",
            "label": "Products"
        },
        {
            "name": "button",
            "label": "Add button",
            "settings": {
                "text": "Add the bundle",
                "tag": "button",
                "style": "primary",
                "_cssClasses": "bfbe-bundle__add",
                "_attributes": [
                    {
                        "id": "bfbebb",
                        "name": "type",
                        "value": "submit"
                    }
                ]
            }
        }
    ],
    "parent": null,
    "cost": {
        "css": "0.91 KB",
        "js": "1.45 KB",
        "dependencies": "shop-live"
    },
    "requires": [
        "WooCommerce"
    ],
    "since": "2.0.0",
    "controlGroups": {
        "_attributes": {
            "title": "Attributes",
            "tab": "style",
            "icon": "html"
        },
        "bfbeBundle": {
            "title": "Bundle",
            "tab": "content"
        },
        "bfbeButton": {
            "title": "Button",
            "tab": "content"
        },
        "bfbeHover": {
            "title": "Hover effect",
            "tab": "style"
        },
        "bfbeOnScroll": {
            "title": "When the page scrolls",
            "tab": "style"
        },
        "bfbeTooltip": {
            "title": "Tooltip",
            "tab": "style"
        }
    },
    "controls": {
        "infoAttributes": {
            "tab": "style",
            "group": "_attributes",
            "content": "<a href=\"https://academy.bricksbuilder.io/article/custom-attributes\" target=\"_blank\" rel=\"noopener\">Custom attributes</a> will be added to the most relevant HTML node.",
            "type": "info"
        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/bundle-builder/\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "source": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Products from",
            "type": "select",
            "options": {
                "category": "A category",
                "tag": "A tag",
                "ids": "Products chosen here"
            },
            "inline": true,
            "placeholder": "A category"
        },
        "category": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Category slug",
            "type": "text",
            "inline": true,
            "placeholder": "kitchen",
            "required": [
                "source",
                "!=",
                [
                    "tag",
                    "ids"
                ]
            ]
        },
        "tag": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Tag slug",
            "type": "text",
            "inline": true,
            "placeholder": "gift",
            "required": [
                "source",
                "=",
                "tag"
            ]
        },
        "products": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Products",
            "type": "select",
            "optionsAjax": {
                "action": "bricks_get_posts",
                "postType": "product"
            },
            "searchable": true,
            "multiple": true,
            "placeholder": "Pick the products",
            "required": [
                "source",
                "=",
                "ids"
            ]
        },
        "most": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Products shown",
            "type": "number",
            "min": 2,
            "max": 24,
            "step": 1,
            "inline": true,
            "placeholder": "12"
        },
        "sepDeal": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "The deal",
            "type": "separator"
        },
        "count": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Products to choose",
            "type": "number",
            "min": 2,
            "max": 12,
            "step": 1,
            "inline": true,
            "placeholder": "3"
        },
        "kind": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Bundle price",
            "type": "select",
            "options": {
                "price": "A set price",
                "percent": "A percentage off each"
            },
            "inline": true,
            "placeholder": "A set price"
        },
        "price": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Set price",
            "type": "number",
            "min": 0,
            "step": 0.01,
            "inline": true,
            "placeholder": "30",
            "required": [
                "kind",
                "!=",
                "percent"
            ]
        },
        "percent": {
            "tab": "content",
            "group": "bfbeBundle",
            "label": "Percentage off",
            "type": "number",
            "min": 1,
            "max": 90,
            "step": 1,
            "inline": true,
            "placeholder": "20",
            "required": [
                "kind",
                "=",
                "percent"
            ]
        },
        "disabledOpacity": {
            "tab": "content",
            "group": "bfbeButton",
            "label": "Disabled opacity",
            "type": "number",
            "min": 0,
            "max": 1,
            "step": 0.05,
            "inline": true,
            "placeholder": 0.55,
            "description": "While the bundle is not complete.",
            "css": [
                {
                    "property": "--bfbe-bundle-dim",
                    "selector": ""
                }
            ]
        },
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow",
                "image2": "Show the product&#039;s second image"
            },
            "inline": true,
            "placeholder": "None"
        },
        "bfbeHoverOn": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverFrom": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Comes from",
            "type": "select",
            "options": {
                "up": "Above",
                "left": "The left",
                "right": "The right"
            },
            "inline": true,
            "placeholder": "Below",
            "required": [
                "bfbeHoverEffect",
                "=",
                "slide"
            ]
        },
        "bfbeHoverStrength": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Strength",
            "type": "number",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "inline": true,
            "placeholder": "1",
            "breakpoints": true,
            "css": [
                {
                    "property": "--bfbe-hv-k",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverSpeed": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Speed",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "300",
            "description": "Milliseconds.",
            "css": [
                {
                    "property": "--bfbe-hv-t",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverDelay": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Delay",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "0",
            "description": "Milliseconds, so parts arrive in sequence.",
            "css": [
                {
                    "property": "--bfbe-hv-d",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "bfbeHoverEffect",
                    "!=",
                    ""
                ],
                [
                    "bfbeHoverEffect",
                    "!=",
                    [
                        "tilt",
                        "follow"
                    ]
                ]
            ]
        },
        "bfbeHoverColor": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Colour",
            "type": "color",
            "inline": true,
            "css": [
                {
                    "property": "--bfbe-hv-c",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "=",
                [
                    "shine",
                    "border"
