        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/spec-scales/\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "scales": {
            "tab": "content",
            "group": "bfbeScales",
            "label": "Scales",
            "type": "repeater",
            "titleProperty": "attribute",
            "selector": ".bfbe-scales__row",
            "placeholder": "Scale",
            "fields": {
                "attribute": {
                    "label": "Attribute",
                    "type": "select",
                    "options": {
                        "pa_colour": "Colour",
                        "pa_material": "Material",
                        "pa_q5-finish": "Q5 Finish",
                        "pa_q5-pattern": "Q5 Pattern",
                        "pa_size": "Size",
                        "pa_warmth": "Warmth"
                    },
                    "searchable": true,
                    "placeholder": "Choose"
                },
                "custom": {
                    "label": "Custom attribute",
                    "type": "text",
                    "inline": true,
                    "placeholder": "Thread count"
                },
                "max": {
                    "label": "Scale maximum",
                    "type": "number",
                    "min": 1,
                    "inline": true,
                    "placeholder": "The number of terms"
                },
                "label": {
                    "label": "Name shown",
                    "type": "text",
                    "inline": true,
                    "placeholder": "The attribute label"
                },
                "pattern": {
                    "label": "Figure",
                    "type": "text",
                    "inline": true,
                    "placeholder": "{value} of {max}",
                    "description": "{value}, {max} and {words} are filled in."
                }
            }
        },
        "layout": {
            "tab": "content",
            "group": "bfbeLook",
