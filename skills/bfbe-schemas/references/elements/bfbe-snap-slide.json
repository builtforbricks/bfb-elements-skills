            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
