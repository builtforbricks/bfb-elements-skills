    "nestable": true,
    "children": [],
    "childrenDefault": [],
    "parent": "bfbe-snap-slider",
    "cost": null,
    "controlGroups": {
        "_attributes": {
            "title": "Attributes",
            "tab": "style",
            "icon": "html"
        },
        "bfbePosition": {
            "title": "Position",
            "tab": "content"
        },
        "bfbeSlide": {
            "title": "Slide",
            "tab": "content"
        },
        "bfbeHover": {
            "title": "Hover effect",
            "tab": "style"
        },
        "bfbeOnScroll": {
            "title": "When the page scrolls",
            "tab": "style"
        }
    },
    "controls": {
        "infoAttributes": {
            "tab": "style",
            "group": "_attributes",
            "content": "<a href=\"https://academy.bricksbuilder.io/article/custom-attributes\" target=\"_blank\" rel=\"noopener\">Custom attributes</a> will be added to the most relevant HTML node.",
            "type": "info"
        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/snap-slider/#parts\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "place": {
            "tab": "content",
            "group": "bfbePosition",
            "label": "Place",
            "type": "select",
            "options": {
                "order": "Where it is in the structure",
                "after": "After a loop item",
                "every": "After every few loop items"
            },
            "inline": true,
            "placeholder": "Where it is in the structure"
        },
        "after": {
            "tab": "content",
            "group": "bfbePosition",
            "label": "After item",
            "type": "number",
            "min": 0,
            "inline": true,
            "placeholder": 2,
            "description": "0 puts it first.",
            "required": [
                "place",
                "=",
                "after"
            ]
        },
        "every": {
            "tab": "content",
            "group": "bfbePosition",
            "label": "Repeat every",
            "description": "Loop items between repeats.",
            "type": "number",
            "min": 1,
            "inline": true,
            "placeholder": 3,
            "required": [
                "place",
                "=",
                "every"
            ]
        },
        "limit": {
            "tab": "content",
            "group": "bfbePosition",
            "label": "Max repeats",
            "type": "number",
            "min": 0,
            "inline": true,
            "placeholder": "No limit",
            "required": [
                "place",
                "=",
                "every"
            ]
        },
        "width": {
            "tab": "content",
            "group": "bfbeSlide",
            "label": "Width",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "From the slider",
            "css": [
                {
                    "property": "--bfbe-ss-w",
                    "selector": ""
                }
            ]
        },
        "align": {
            "tab": "content",
            "group": "bfbeSlide",
            "label": "Snap to",
            "type": "select",
            "options": {
                "start": "Its start edge",
                "center": "Its centre",
                "end": "Its end edge"
            },
            "inline": true,
            "placeholder": "From the slider",
            "css": [
                {
                    "property": "--bfbe-ss-align",
                    "selector": ""
                }
            ]
        },
