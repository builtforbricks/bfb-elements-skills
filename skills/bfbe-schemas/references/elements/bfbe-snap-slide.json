            "tab": "content",
            "label": "Query loop",
            "type": "checkbox"
        },
        "query": {
            "tab": "content",
            "label": "Query",
            "type": "query",
            "popup": true,
            "inline": true,
            "required": [
                "hasLoop",
                "!=",
                ""
            ]
        },
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow"
            },
            "inline": true,
            "placeholder": "None"
