{
    "name": "bfbe-compare-tray",
    "label": "BFB Compare Tray",
    "pack": "pro",
    "skill": "bfbe-compare-tray",
    "docs": "https://builtforbricks.com/bfb-elements/docs/compare-tray/",
    "nestable": true,
    "children": [],
    "childrenDefault": [
        {
            "name": "text-basic",
            "label": "Count",
            "settings": {
                "text": "Compare ({bfbe_compare_count})",
                "tag": "p",
                "_typography": {
                    "font-weight": "600"
                }
            }
        },
        {
            "name": "block",
            "label": "Products being compared",
            "settings": {
                "hasLoop": true,
                "query": {
                    "objectType": "bfbeShopCompare"
                },
                "_direction": "row",
                "_alignItems": "center",
                "_columnGap": "8px",
                "_width": "auto",
                "_padding": {
                    "top": "4",
                    "right": "4",
                    "bottom": "4",
                    "left": "4"
                },
                "_border": {
                    "width": {
                        "top": "1",
                        "right": "1",
                        "bottom": "1",
                        "left": "1"
                    },
                    "style": "solid",
                    "color": {
                        "raw": "var(--bfbe-line, #e4e4e7)"
                    },
                    "radius": {
                        "top": "8",
                        "right": "8",
                        "bottom": "8",
                        "left": "8"
                    }
                }
            },
            "children": [
                {
                    "name": "image",
                    "label": "Picture",
                    "settings": {
                        "image": {
                            "useDynamicData": "{featured_image}",
                            "size": "thumbnail"
                        },
                        "_width": "44px",
                        "_height": "44px",
                        "_objectFit": "cover"
                    }
                },
                {
                    "name": "product-title",
                    "label": "Name",
                    "settings": {
                        "tag": "span",
                        "linkToProduct": true,
                        "_typography": {
                            "font-size": "14px"
                        }
                    }
                }
            ]
        },
        {
            "name": "button",
            "label": "Compare now",
            "settings": {
                "text": "Compare now",
                "style": "primary",
                "link": {
                    "type": "external",
                    "url": "{bfbe_compare_url}"
                },
                "_conditions": [
                    [
                        {
                            "id": "bfbect",
                            "key": "dynamic_data",
                            "dynamic_data": "{bfbe_compare_url}",
                            "compare": "empty_not"
                        }
                    ]
                ]
            }
        }
    ],
    "parent": null,
    "cost": {
        "css": "0.50 KB",
        "js": "0.90 KB",
        "dependencies": "none"
    },
    "requires": [
        "WooCommerce"
    ],
    "since": "2.0.0",
    "controlGroups": {
        "_attributes": {
            "title": "Attributes",
            "tab": "style",
            "icon": "html"
        },
        "bfbeTray": {
            "title": "Tray",
            "tab": "content"
        },
        "bfbeBuilder": {
            "title": "In the builder",
            "tab": "content"
        },
        "bfbeHover": {
            "title": "Hover effect",
            "tab": "style"
        },
        "bfbeOnScroll": {
            "title": "When the page scrolls",
            "tab": "style"
        },
        "bfbeTooltip": {
            "title": "Tooltip",
            "tab": "style"
        }
    },
    "controls": {
        "infoAttributes": {
            "tab": "style",
            "group": "_attributes",
            "content": "<a href=\"https://academy.bricksbuilder.io/article/custom-attributes\" target=\"_blank\" rel=\"noopener\">Custom attributes</a> will be added to the most relevant HTML node.",
            "type": "info"
        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/compare-tray/\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "trayName": {
            "tab": "content",
            "group": "bfbeTray",
            "label": "Tray name",
            "type": "text",
            "inline": true,
            "placeholder": "Compare",
            "description": "Read out as the name of the tray."
        },
        "builderView": {
            "tab": "content",
            "group": "bfbeBuilder",
            "label": "Show it",
            "type": "select",
            "options": {
                "open": "In the flow, so you can style it",
                "live": "Working, as on the site"
            },
            "inline": true,
            "placeholder": "In the flow, so you can style it",
            "description": "Working means it shows and hides as outside."
        },
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow",
                "image2": "Show the product&#039;s second image"
            },
            "inline": true,
            "placeholder": "None"
        },
        "bfbeHoverOn": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverFrom": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Comes from",
            "type": "select",
            "options": {
                "up": "Above",
                "left": "The left",
                "right": "The right"
            },
            "inline": true,
            "placeholder": "Below",
            "required": [
                "bfbeHoverEffect",
                "=",
                "slide"
            ]
        },
        "bfbeHoverStrength": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Strength",
            "type": "number",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "inline": true,
            "placeholder": "1",
            "breakpoints": true,
            "css": [
                {
                    "property": "--bfbe-hv-k",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverSpeed": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Speed",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "300",
            "description": "Milliseconds.",
            "css": [
                {
                    "property": "--bfbe-hv-t",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverDelay": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Delay",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "0",
            "description": "Milliseconds, so parts arrive in sequence.",
            "css": [
                {
                    "property": "--bfbe-hv-d",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "bfbeHoverEffect",
                    "!=",
                    ""
                ],
                [
                    "bfbeHoverEffect",
                    "!=",
                    [
                        "tilt",
                        "follow"
                    ]
                ]
            ]
        },
        "bfbeHoverColor": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Colour",
            "type": "color",
            "inline": true,
            "css": [
                {
                    "property": "--bfbe-hv-c",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "=",
                [
                    "shine",
                    "border"
                ]
            ]
        },
        "bfbeHoverOff": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Off below",
            "type": "select",
            "options": {
                "480": "480 px",
                "640": "640 px",
                "768": "768 px",
                "992": "992 px"
            },
            "inline": true,
            "placeholder": "Never",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverScope": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Children respond to hover",
            "type": "checkbox",
            "description": "Parts inside set to A hovered parent move."
        },
        "bfbeHsWhen": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "label": "When scrolled",
            "type": "select",
            "options": {
                "hide": "Hides",
                "fade": "Fades out, keeps its space",
                "show": "Appears only then"
            },
            "inline": true,
            "placeholder": "Stays as it is"
        },
        "bfbeHsCollapse": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "label": "Collapses",
            "type": "select",
            "options": {
                "across": "Sideways"
            },
            "inline": true,
            "placeholder": "Downward",
            "required": [
                "bfbeHsWhen",
                "=",
                [
                    "hide",
                    "show"
                ]
            ]
        },
        "bfbeHsOver": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "label": "Over the first section",
            "type": "select",
            "options": {
                "hide": "Hides",
                "show": "Appears only then"
            },
            "inline": true,
            "placeholder": "Stays as it is",
            "description": "Only with the header over the first section."
        },
        "bfbeHsStyleSep": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "type": "separator",
            "label": "Scrolled: styling"
        },
        "bfbeHsPadding": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "label": "Padding",
            "type": "dimensions",
            "css": [
                {
                    "property": "padding",
                    "selector": "&.bfbe-hs--scrolled"
