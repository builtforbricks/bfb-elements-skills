{
    "name": "bfbe-bought-together",
    "label": "BFB Bought Together",
    "pack": "pro",
    "skill": "bfbe-bought-together",
    "docs": "https://builtforbricks.com/bfb-elements/docs/bought-together/",
    "nestable": true,
    "children": [
        "bfbe-bought-together-products",
        "bfbe-bought-together-total"
    ],
    "childrenDefault": [
        {
            "name": "bfbe-bought-together-products",
            "label": "Products"
        },
        {
            "name": "bfbe-bought-together-total",
            "label": "Total"
        },
        {
            "name": "button",
            "label": "Add button",
            "settings": {
                "text": "Add the ticked products",
                "tag": "button",
                "style": "primary",
                "_cssClasses": "bfbe-bt__add",
                "_attributes": [
                    {
                        "id": "bfbebt",
                        "name": "type",
                        "value": "submit"
                    }
                ]
            }
        }
    ],
    "parent": null,
    "cost": {
        "css": "1.37 KB",
        "js": "1.13 KB",
        "dependencies": "shop-live"
    },
    "requires": [
        "WooCommerce"
    ],
    "since": "2.0.0",
    "controlGroups": {
        "_attributes": {
            "title": "Attributes",
            "tab": "style",
            "icon": "html"
        },
        "bfbeSet": {
            "title": "Set",
            "tab": "content"
        },
        "bfbeHover": {
            "title": "Hover effect",
            "tab": "style"
        },
        "bfbeOnScroll": {
            "title": "When the page scrolls",
            "tab": "style"
        },
        "bfbeTooltip": {
            "title": "Tooltip",
            "tab": "style"
        }
    },
    "controls": {
        "infoAttributes": {
            "tab": "style",
            "group": "_attributes",
            "content": "<a href=\"https://academy.bricksbuilder.io/article/custom-attributes\" target=\"_blank\" rel=\"noopener\">Custom attributes</a> will be added to the most relevant HTML node.",
            "type": "info"
        },
        "bfbeDocs": {
            "tab": "content",
            "type": "info",
            "content": "<a href=\"https://builtforbricks.com/bfb-elements/docs/bought-together/\" target=\"_blank\" rel=\"noopener\">Documentation &#8599;</a>"
        },
        "product": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Product",
            "type": "select",
            "optionsAjax": {
                "action": "bricks_get_posts",
                "postType": "product"
            },
            "searchable": true,
            "placeholder": "The product of the page"
        },
        "source": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Companions from",
            "type": "select",
            "options": {
                "pick": "Picked here",
                "upsells": "Its upsells",
                "cross": "Its cross-sells",
                "orders": "Bought with it in your orders"
            },
            "inline": true,
            "placeholder": "Picked here"
        },
        "products": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Companions",
            "type": "select",
            "optionsAjax": {
                "action": "bricks_get_posts",
                "postType": "product"
            },
            "searchable": true,
            "multiple": true,
            "placeholder": "Pick up to three products",
            "required": [
                "source",
                "!=",
                [
                    "upsells",
                    "cross",
                    "orders"
                ]
            ]
        },
        "most": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Products in the set",
            "type": "number",
            "min": 2,
            "max": 4,
            "step": 1,
            "inline": true,
            "placeholder": "3",
            "description": "This product included."
        },
        "variable": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Other variable products",
            "type": "select",
            "options": {
                "choose": "With a select of their options",
                "leave": "Left out"
            },
            "inline": true,
            "placeholder": "With a select of their options"
        },
        "unticked": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Start the others unticked",
            "type": "checkbox"
        },
        "discount": {
            "tab": "content",
            "group": "bfbeSet",
            "label": "Set discount (%)",
            "type": "number",
            "min": 0,
            "max": 90,
            "step": 1,
            "inline": true,
            "placeholder": "0",
            "description": "While the whole set is in the cart."
        },
        "bfbeHoverEffect": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Effect",
            "type": "select",
            "options": {
                "lift": "Lift",
                "zoom": "Zoom the picture",
                "shine": "Shine",
                "border": "Gradient border",
                "tilt": "Tilt",
                "follow": "Follow the pointer",
                "fade": "Fade in",
                "slide": "Slide in",
                "grow": "Grow",
                "image2": "Show the product&#039;s second image"
            },
            "inline": true,
            "placeholder": "None"
        },
        "bfbeHoverOn": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Responds to",
            "type": "select",
            "options": {
                "parent": "A hovered parent"
            },
            "inline": true,
            "placeholder": "This element",
            "description": "The parent needs Children respond to hover.",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverFrom": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Comes from",
            "type": "select",
            "options": {
                "up": "Above",
                "left": "The left",
                "right": "The right"
            },
            "inline": true,
            "placeholder": "Below",
            "required": [
                "bfbeHoverEffect",
                "=",
                "slide"
            ]
        },
        "bfbeHoverStrength": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Strength",
            "type": "number",
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "inline": true,
            "placeholder": "1",
            "breakpoints": true,
            "css": [
                {
                    "property": "--bfbe-hv-k",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverSpeed": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Speed",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "300",
            "description": "Milliseconds.",
            "css": [
                {
                    "property": "--bfbe-hv-t",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverDelay": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Delay",
            "type": "number",
            "min": 0,
            "max": 3000,
            "step": 10,
            "inline": true,
            "placeholder": "0",
            "description": "Milliseconds, so parts arrive in sequence.",
            "css": [
                {
                    "property": "--bfbe-hv-d",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "bfbeHoverEffect",
                    "!=",
                    ""
                ],
                [
                    "bfbeHoverEffect",
                    "!=",
                    [
                        "tilt",
                        "follow"
                    ]
                ]
            ]
        },
        "bfbeHoverColor": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Colour",
            "type": "color",
            "inline": true,
            "css": [
                {
                    "property": "--bfbe-hv-c",
                    "selector": ""
                }
            ],
            "required": [
                "bfbeHoverEffect",
                "=",
                [
                    "shine",
                    "border"
                ]
            ]
        },
        "bfbeHoverOff": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Off below",
            "type": "select",
            "options": {
                "480": "480 px",
                "640": "640 px",
                "768": "768 px",
                "992": "992 px"
            },
            "inline": true,
            "placeholder": "Never",
            "required": [
                "bfbeHoverEffect",
                "!=",
                ""
            ]
        },
        "bfbeHoverScope": {
            "tab": "style",
            "group": "bfbeHover",
            "label": "Children respond to hover",
            "type": "checkbox",
            "description": "Parts inside set to A hovered parent move."
        },
        "bfbeHsWhen": {
            "tab": "style",
            "group": "bfbeOnScroll",
            "label": "When scrolled",
            "type": "select",
            "options": {
                "hide": "Hides",
                "fade": "Fades out, keeps its space",
                "show": "Appears only then"
            },
            "inline": true,
            "placeholder": "Stays as it is"
        },
