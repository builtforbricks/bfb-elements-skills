{
    "name": "form-fields",
    "label": "BFB Form Fields",
    "pack": "pro",
    "feature": true,
    "on": "Bricks' own form element (`form`)",
    "docs": "https://builtforbricks.com/bfb-elements/docs/form-fields/",
    "controlGroups": {
        "bfbeFields": {
            "title": "Cards and pills",
            "tab": "content"
        },
        "bfbeFloat": {
            "title": "Floating labels",
            "tab": "content"
        },
        "bfbeBuilder": {
            "title": "In the builder",
            "tab": "content"
        }
    },
    "controls": {
        "sepChoiceCards": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Cards",
            "type": "separator"
        },
        "choiceMin": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Width, at least",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "160px",
            "css": [
                {
                    "property": "--bfbe-ff-min",
                    "selector": ""
                }
            ]
        },
        "choiceColumns": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Per row",
            "type": "number",
            "min": 1,
            "max": 8,
            "step": 1,
            "inline": true,
            "placeholder": "Fits the width",
            "css": [
                {
                    "property": "--bfbe-ff-cols",
                    "selector": "",
                    "value": "repeat(%s, minmax(0, 1fr))"
                }
            ]
        },
        "choiceGap": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Space between",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "12px",
            "css": [
                {
                    "property": "--bfbe-ff-gap",
                    "selector": ""
                }
            ]
        },
        "choicePadding": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Padding",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "16px",
            "css": [
                {
                    "property": "--bfbe-ff-pad",
                    "selector": ""
                }
            ]
        },
        "choiceBorder": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Border",
            "type": "border",
            "css": [
                {
                    "property": "border",
                    "selector": ".bfbe-ff__card"
                }
            ]
        },
        "choiceBackground": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Background",
            "type": "color",
            "css": [
                {
                    "property": "background-color",
                    "selector": ".bfbe-ff__card"
                }
            ]
        },
        "choiceShadow": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Shadow",
            "type": "box-shadow",
            "css": [
                {
                    "property": "box-shadow",
                    "selector": ".bfbe-ff__card"
                }
            ]
        },
        "choiceHover": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Hover border",
            "type": "color",
            "css": [
                {
                    "property": "--bfbe-ff-hover",
                    "selector": ""
                }
            ]
        },
        "sepChoiceChosen": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Chosen",
            "type": "separator"
        },
        "choiceAccent": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Colour",
            "type": "color",
            "css": [
                {
                    "property": "--bfbe-ff-accent",
                    "selector": ""
                }
            ]
        },
        "choiceChosenBackground": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Background",
            "type": "color",
            "css": [
                {
                    "property": "--bfbe-ff-accent-bg",
                    "selector": ""
                }
            ]
        },
        "choiceChosenText": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Text",
            "type": "color",
            "css": [
                {
                    "property": "--bfbe-ff-accent-text",
                    "selector": ""
                }
            ]
        },
        "sepChoiceInside": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Inside a card",
            "type": "separator"
        },
        "choiceDirection": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Direction",
            "type": "direction",
            "inline": true,
            "css": [
                {
                    "property": "flex-direction",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card"
                },
                {
                    "property": "--bfbe-ff-row",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card",
                    "value": "1",
                    "required": "row"
                },
                {
                    "property": "--bfbe-ff-row",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card",
                    "value": "1",
                    "required": "row-reverse"
                },
                {
                    "property": "--bfbe-ff-row",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card",
                    "value": "0",
                    "required": "column"
                },
                {
                    "property": "--bfbe-ff-row",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card",
                    "value": "0",
                    "required": "column-reverse"
                }
            ]
        },
        "choiceJustify": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Align main axis",
            "type": "justify-content",
            "inline": true,
            "css": [
                {
                    "property": "justify-content",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card"
                }
            ]
        },
        "choiceAlignItems": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Align cross axis",
            "type": "align-items",
            "inline": true,
            "css": [
                {
                    "property": "align-items",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card"
                }
            ]
        },
        "choiceInGap": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Gap",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "8px",
            "css": [
                {
                    "property": "gap",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__card"
                }
            ]
        },
        "sepChoiceIcon": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Icon",
            "type": "separator"
        },
        "choiceIcon": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Size",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "24px",
            "css": [
                {
                    "property": "--bfbe-ff-icon",
                    "selector": ""
                }
            ]
        },
        "choiceIconColor": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Colour",
            "type": "color",
            "css": [
                {
                    "property": "--bfbe-ff-icon-color",
                    "selector": ""
                }
            ]
        },
        "sepChoicePicture": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Picture",
            "type": "separator"
        },
        "choicePicWidth": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Width",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "Auto",
            "description": "Auto: full in a column, 72px in a row.",
            "css": [
                {
                    "property": "--bfbe-ff-pic-w",
                    "selector": ""
                }
            ]
        },
        "choicePicRatio": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Proportions",
            "type": "select",
            "options": {
                "1 / 1": "Square",
                "4 / 3": "4:3",
                "3 / 2": "3:2",
                "16 / 9": "16:9",
                "3 / 4": "Upright 3:4"
            },
            "inline": true,
            "placeholder": "Its own",
            "css": [
                {
                    "property": "aspect-ratio",
                    "selector": ".bfbe-ff__pic"
                }
            ]
        },
        "choicePicFit": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Fit",
            "type": "select",
            "options": {
                "cover": "Fill, trimmed",
                "contain": "Whole, with space"
            },
            "inline": true,
            "placeholder": "Fill, trimmed",
            "required": [
                "choicePicRatio",
                "!=",
                ""
            ],
            "css": [
                {
                    "property": "object-fit",
                    "selector": ".bfbe-ff__pic"
                }
            ]
        },
        "choicePicBorder": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Border",
            "type": "border",
            "css": [
                {
                    "property": "border",
                    "selector": ".bfbe-ff__pic"
                }
            ]
        },
        "sepChoiceWords": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Words",
            "type": "separator"
        },
        "choiceTextAlign": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Text align",
            "type": "text-align",
            "inline": true,
            "css": [
                {
                    "property": "text-align",
                    "selector": "[data-bfbe-choice=\"cards\"] .bfbe-ff__body"
                }
            ]
        },
        "choiceTitleTypography": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Typography",
            "type": "typography",
            "css": [
                {
                    "property": "typography",
                    "selector": ".bfbe-ff__title"
                }
            ]
        },
        "choiceTextTypography": {
            "tab": "content",
            "group": "bfbeFields",
            "label": "Description typography",
            "type": "typography",
            "css": [
                {
                    "property": "typography",
                    "selector": ".bfbe-ff__text"
                }
            ]
        },
        "labelsAt": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Labels",
            "type": "select",
            "options": {
                "above": "Above the field",
                "border": "Floating, on the border"
            },
            "inline": true,
            "placeholder": "Above the field",
            "required": [
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatHeight": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Height on the border",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "0px",
            "description": "Nought centres it on the line; less is higher.",
            "css": [
                {
                    "property": "--bfbe-fl-height",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatInset": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Inset",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "12px",
            "description": "From the field edge to where the border opens.",
            "css": [
                {
                    "property": "--bfbe-fl-inset",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatGap": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Gap",
            "type": "number",
            "units": true,
            "inline": true,
            "placeholder": "4px",
            "description": "The opening either side of the label.",
            "css": [
                {
                    "property": "--bfbe-fl-gap",
                    "selector": ""
                }
            ],
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatRestColor": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Resting colour",
            "type": "color",
            "css": [
                {
                    "property": "color",
                    "selector": "&.bfbe-pc--float:not([data-bfbe-fl-preview]) .bfbe-pc__field[data-bfbe-float]:not(:focus-within):has(.bfbe-pc__input:placeholder-shown) > .bfbe-pc__label"
                },
                {
                    "property": "color",
                    "selector": "&.bfbe-pc--float:not([data-bfbe-fl-preview]) [data-bfbe-float]:not(:focus-within):has(.bfbe-fl__input:placeholder-shown) > .bfbe-fl__label"
                }
            ],
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatFocusColor": {
            "tab": "content",
            "group": "bfbeFloat",
            "label": "Colour while typing",
            "type": "color",
            "css": [
                {
                    "property": "color",
                    "selector": "&.bfbe-pc--float .bfbe-pc__field[data-bfbe-float]:focus-within > .bfbe-pc__label"
                },
                {
                    "property": "color",
                    "selector": "&.bfbe-pc--float [data-bfbe-float]:focus-within > .bfbe-fl__label"
                }
            ],
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        },
        "floatPreview": {
            "tab": "content",
            "group": "bfbeBuilder",
            "label": "Floating labels",
            "type": "select",
            "options": {
                "page": "As the page shows them",
                "up": "Risen, so you can style them"
            },
            "inline": true,
            "placeholder": "As the page shows them",
            "required": [
                [
                    "labelsAt",
                    "=",
                    "border"
                ],
                [
                    "showLabels",
                    "!=",
                    ""
                ]
            ]
        }
    },
    "fieldControls": {
        "bfbeChoice": {
            "label": "Show the options as",
            "type": "select",
            "options": {
                "list": "A list",
                "cards": "Cards",
                "pills": "Pills"
            },
            "inline": true,
            "placeholder": "A list",
            "required": [
                "type",
                "=",
                [
                    "radio",
                    "checkbox"
                ]
            ]
        },
        "bfbeChoiceText": {
            "label": "Option descriptions",
            "type": "textarea",
            "placeholder": "One line per option, in order",
            "required": [
                "bfbeChoice",
                "=",
                "cards"
            ]
        },
        "bfbeChoiceMedia": {
            "label": "Icons and pictures",
            "type": "repeater",
            "placeholder": "Option",
            "description": "One row per option, in order. Empty rows skip.",
            "fields": {
                "icon": {
                    "label": "Icon",
                    "type": "icon"
                },
                "image": {
                    "label": "Picture",
                    "type": "image",
                    "description": "Shown instead of the icon."
                }
            },
            "required": [
                "bfbeChoice",
                "=",
                "cards"
            ]
        },
        "bfbeChoiceSide": {
            "label": "Question beside the options",
            "type": "checkbox",
            "required": [
                "bfbeChoice",
                "=",
                "pills"
            ]
        },
        "bfbeShowWhen": {
            "label": "Show only when field",
            "type": "text",
            "inline": true,
            "placeholder": "Its ID"
        },
        "bfbeShowValue": {
            "label": "Has the value",
            "type": "text",
            "inline": true,
            "placeholder": "Any value",
            "description": "Several: a, b. Not this one: !a.",
            "required": [
                "bfbeShowWhen",
                "!=",
                ""
            ]
        }
    }
}
