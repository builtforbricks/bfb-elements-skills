{
    "name": "shop-account",
    "label": "BFB Shop account",
    "pack": "free",
    "feature": true,
    "shape": "hosts",
    "on": "Bricks' own Account - Register form (`woocommerce-account-form-register`), Account - Page (`woocommerce-account-page`), `woocommerce-account-register-form`",
