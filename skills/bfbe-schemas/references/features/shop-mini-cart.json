    "pack": "free and pro",
    "feature": true,
    "shape": "hosts",
    "on": "Bricks' own Mini cart (`woocommerce-mini-cart`)",
    "job": "the shop's settings on Bricks' Mini cart: the accessible panel, its empty state, its look, save for later and undo on its lines",
